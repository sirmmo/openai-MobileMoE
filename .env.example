# Copy to .env and edit. All values are optional except HF_TOKEN, which the
# gated MobileMoE repos require on first download.

# Read token from https://huggingface.co/settings/tokens, after accepting the
# license on the model page.
# HF_TOKEN=hf_...

# Which checkpoint to serve. Any of:
#   facebook/MobileMoE-S-QAT   (default: 272M active / 1.3B total, INT4)
#   facebook/MobileMoE-S-SFT   facebook/MobileMoE-S-Base
#   facebook/MobileMoE-M-QAT   facebook/MobileMoE-M-SFT   facebook/MobileMoE-M-Base
#   facebook/MobileMoE-L-QAT   facebook/MobileMoE-L-SFT   facebook/MobileMoE-L-Base
MOBILEMOE_MODEL=facebook/MobileMoE-S-QAT

# Model id advertised by GET /v1/models. Defaults to the repo's last segment.
# MOBILEMOE_MODEL_ID=MobileMoE-S-QAT

# Bind address / port for the server.
MOBILEMOE_HOST=0.0.0.0
MOBILEMOE_PORT=8000

# Require `Authorization: Bearer <key>`. Unset = open server.
# MOBILEMOE_API_KEY=sk-local-mobilemoe

# 404 requests naming any other model. Off by default so clients that hard-code
# e.g. "gpt-4o-mini" keep working.
MOBILEMOE_STRICT_MODEL=false

# auto = CUDA if available, else CPU. Or: cpu, cuda, cuda:1, mps.
MOBILEMOE_DEVICE=auto

# auto = bfloat16 on CUDA, float32 on CPU. bfloat16 halves CPU memory but is
# slower on CPUs without native bf16 support.
MOBILEMOE_DTYPE=auto

# sdpa or eager. Unset lets Transformers choose.
# MOBILEMOE_ATTN_IMPLEMENTATION=sdpa

# torch.set_num_threads for CPU inference. Unset keeps torch's default.
# MOBILEMOE_THREADS=8

# Default generation cap when a request omits max_tokens.
MOBILEMOE_MAX_NEW_TOKENS=512

# Override the context window (default: read from the model, 8192).
# MOBILEMOE_MAX_CONTEXT=8192

# Temperature when a request omits one. 0 = greedy, as the model card advises.
MOBILEMOE_DEFAULT_TEMPERATURE=0

# Repetition penalty when a request omits one (1.0 = off). 1.1-1.2 stops the
# small checkpoints looping on repetitive input, but penalises legitimate
# repetition in code and queries; turn on only for a fixed prose workload.
MOBILEMOE_DEFAULT_REPETITION_PENALTY=1.0

# Requests serialize through one generation thread; reject past this backlog.
MOBILEMOE_MAX_QUEUE_DEPTH=16
MOBILEMOE_REQUEST_TIMEOUT=600

# How tool exchanges in the history reach the model. `context` (default) drops
# call-only assistant turns and turns each tool result into a user turn, which
# is what a model with no tool training needs to answer in prose; `template`
# passes the tool role and serialized calls to the chat template unchanged.
MOBILEMOE_TOOL_HISTORY=context

# Include the x_mobilemoe block (timings, warnings) on responses.
MOBILEMOE_EXPOSE_EXTRAS=true

# CORS. Comma-separated, or * for any origin.
MOBILEMOE_ALLOWED_ORIGINS=*
